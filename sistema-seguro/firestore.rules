rules_version = '2';

// =============================================================================
// ERP de obras y nóminas — reglas de Firestore
//
// ⚠️ REQUISITO ANTES DE DESPLEGAR:
//    esAdmin() NO puede deducirse de la colección `trabajadores`, porque sus
//    documentos usan ID autogenerado y se vinculan a la cuenta por email, y las
//    reglas no pueden hacer queries. Hace falta uno de estos dos, o el panel de
//    oficina dejará de funcionar por completo:
//
//    a) Custom Claim:  request.auth.token.admin == true   (vía Admin SDK)
//    b) Documento:     roles/{uid}  ->  { admin: true }   (creado a mano en la consola)
//
//    Estas reglas aceptan las dos. Crea al menos un admin ANTES de desplegar y
//    compruébalo en el emulador.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------- helpers

    function autenticado() {
      return request.auth != null;
    }

    function correo() {
      return autenticado() && 'email' in request.auth.token
             ? request.auth.token.email.lower()
             : '';
    }

    // Los get()/exists() dentro de reglas NO pasan por estas mismas reglas,
    // así que la colección `roles` puede quedar cerrada a los clientes.
    function esAdmin() {
      return autenticado() && (
        request.auth.token.get('admin', false) == true ||
        (
          exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('admin', false) == true
        )
      );
    }

    // Campos que cambian entre el documento actual y el entrante
    function tocados() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ------------------------------------------------------- partes_de_trabajo

    match /partes_de_trabajo/{parteId} {

      // Lo único que el operario puede enviar al crear un parte.
      // Coincide exactamente con el payload de ParteTrabajo.jsx.
      //
      // AMPLIADA (Pieza 2), solo con campos nuevos:
      //   asignacionId  de qué cuadrante sale el parte; null si se creó libre
      //   horasTaller   horas reportadas por el operario, INFORMATIVAS (D5)
      //   horasCalle    idem. No entran en el cálculo de nómina: las normales son
      //                 base mensual fija y las extra se asignan al validar.
      //
      // hasOnly() rechaza cualquier campo fuera de esta lista, así que añadir un
      // campo en el cliente sin tocarla aquí deja al operario sin poder enviar.
      function camposDelOperario() {
        return ['obra', 'tareasRealizadas', 'trabajo', 'materialesUsados', 'firma',
                'creador', 'nombreTrabajador', 'fecha', 'hora', 'timestamp', 'estado',
                'obraId', 'trabajadorId',
                'asignacionId', 'horasTaller', 'horasCalle'];
      }

      // Lo que la oficina escribe al validar (PanelOficina.jsx:251).
      function camposDeValidacion() {
        return ['estado', 'fechaValidacion', 'certificado', 'facturado', 'papelera'];
      }

      // ÚNICA excepción a la inmutabilidad de un parte aprobado: ciclo documental.
      // Sin esto, certificar / facturar / papelera dejan de funcionar.
      function camposPostAprobacion() {
        return ['certificado', 'idCertificacion', 'facturado', 'papelera'];
      }

      function esSuyo() {
        return autenticado() && resource.data.get('creador', '').lower() == correo();
      }

      // El operario solo ve los suyos; la oficina ve todo.
      // La query de ParteTrabajo.jsx:55 filtra por creador, así que list pasa.
      allow get, list: if esAdmin() || esSuyo();

      // El operario crea SU parte, siempre pendiente y sin campos de oficina.
      // El orden importa: primero hasAll, para no evaluar campos inexistentes.
      allow create: if autenticado()
                    && request.resource.data.keys().hasAll(['obra', 'creador', 'estado', 'timestamp'])
                    && request.resource.data.keys().hasOnly(camposDelOperario())
                    && request.resource.data.creador.lower() == correo()
                    && request.resource.data.estado == 'pendiente';

      // Nadie que no sea oficina modifica un parte. Ni siquiera su autor.
      allow update: if esAdmin() && (
                      // 1. pendiente o rechazado: se valida, se rechaza, se restaura,
                      //    o se manda a la papelera
                      (
                        resource.data.get('estado', '') in ['pendiente', 'rechazado']
                        && tocados().hasOnly(camposDeValidacion())
                        && request.resource.data.estado in ['pendiente', 'aprobado', 'rechazado']
                      )
                      ||
                      // 2. aprobado: congelado salvo el ciclo documental
                      (
                        resource.data.get('estado', '') == 'aprobado'
                        && tocados().hasOnly(camposPostAprobacion())
                        && request.resource.data.estado == 'aprobado'
                      )
                    );

      // Borrado definitivo desde la papelera.
      allow delete: if esAdmin();
    }

    // ------------------------------------------------------------- validaciones
    // Cuadrilla y horas extra por operario, fuera del parte para que su creador no
    // vea las de sus compañeros. Solo oficina, ni siquiera el autor del parte.

    match /validaciones/{parteId} {
      allow read: if esAdmin();
      allow create, update: if esAdmin()
                            && request.resource.data.keys().hasAll(['cuadrilla', 'horasExtraAsignadas'])
                            && request.resource.data.cuadrilla is list
                            && request.resource.data.horasExtraAsignadas is number;
      allow delete: if esAdmin();
    }

    // ------------------------------------------------------------ trabajadores

    match /trabajadores/{trabajadorId} {
      // El operario solo puede leer SU ficha (para resolver su nombre y su rol).
      // Comparación en minúsculas: los documentos se guardan con email en
      // minúsculas pero App.jsx:40 consulta con el email crudo de Auth.
      function esSuFicha() {
        return autenticado() && resource.data.get('email', '').lower() == correo();
      }

      allow get, list: if esAdmin() || esSuFicha();

      // Solo oficina escribe aquí. Esto es lo que impide que nadie se toque su
      // propio campo `rol`: un no-admin no puede escribir NADA en la colección.
      allow create, update, delete: if esAdmin();
    }

    // -------------------------------------------------------------------- roles

    // Fuente de verdad de los permisos. Cerrada a todo cliente: se mantiene desde
    // la consola de Firebase o con el Admin SDK. Las reglas la leen con get(),
    // que no pasa por estas reglas.
    match /roles/{uid} {
      allow read, write: if false;
    }

    // --------------------------------------------------- obras e inventario
    // El operario necesita leerlas enteras para rellenar el parte
    // (ParteTrabajo.jsx:42 y :45). Escribir, solo oficina.

    match /obras/{obraId} {
      allow get, list: if autenticado();
      allow create, update, delete: if esAdmin();
    }

    match /inventario/{materialId} {
      allow get, list: if autenticado();
      allow create, update, delete: if esAdmin();
    }

    // ------------------------------------- documentos económicos: solo oficina

    match /presupuestos/{presupuestoId} {
      allow read, write: if esAdmin();
    }

    match /certificaciones/{certificacionId} {
      allow read, write: if esAdmin();
    }

    match /facturas/{facturaId} {
      allow read, write: if esAdmin();
    }

    // ----------------------------------------------------------------- nominas
    // Liquidaciones CERRADAS. Un snapshot congelado, no un cálculo en vivo: se crea
    // una vez y no se modifica jamás.
    //
    // CADA CIERRE ES UN DOCUMENTO NUEVO. El id lleva dentro el periodo y la versión
    // —"2026-08-v1", "2026-08-v2"— y el vigente es el de versión más alta. Corregir
    // una liquidación no reescribe nada: emite la siguiente versión, y la anterior
    // queda consultable. Que no se pueda sobrescribir no depende de ninguna
    // comprobación: `create` solo se evalúa cuando el documento no existe, así que
    // repetir un cierre falla aquí, sin código que lo impida.
    //
    // El periodo es un MES NATURAL. La fórmula de la nómina es base mensual menos
    // ausencias: cerrar diez días con una base de 160 h no daría un número
    // discutible, daría uno sin sentido.
    //
    // Las líneas NO exigen que su cabecera exista: cabecera y líneas se escriben en
    // el mismo lote, y dentro de un lote exists() ve el estado anterior. Pedirlo
    // haría imposible el primer cierre.

    match /nominas/{cierreId} {
      allow read: if esAdmin();

      allow create: if esAdmin()
                    && request.resource.data.estado == 'cerrado'
                    && request.resource.data.cerradoPor == request.auth.uid
                    && request.resource.data.periodo.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
                    && request.resource.data.version is int
                    && request.resource.data.version > 0
                    && cierreId == request.resource.data.periodo + '-v' + string(request.resource.data.version)
                    && request.resource.data.rangoInicio is int
                    && request.resource.data.rangoFin is int
                    && request.resource.data.rangoInicio <= request.resource.data.rangoFin
                    && request.resource.data.totales is map;

      allow update, delete: if false;

      // Una línea por trabajador. El id del documento es su trabajadorId, así que
      // un mismo trabajador no puede aparecer dos veces en el mismo cierre.
      match /lineas/{trabajadorId} {
        allow read: if esAdmin();

        allow create: if esAdmin()
                      && request.resource.data.trabajadorId == trabajadorId
                      && request.resource.data.horasNormales is number
                      && request.resource.data.horasExtra is number
                      && request.resource.data.total is number;

        allow update, delete: if false;
      }
    }

    // ------------------------------------------------- usuarios (colección legacy)
    // Solo la lee App.jsx:53 como respaldo, con el uid del propio usuario.

    match /usuarios/{uid} {
      allow get: if autenticado() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ============================================== PLANIFICACIÓN (bloque nuevo)
    //
    // Todo lo que sigue es ADITIVO: no cambia ni una cláusula de lo ya desplegado.
    // Hacen falta reglas explícitas porque el match final deniega todo por defecto.

    // --------------------------------------------------- catálogos de recursos
    // Mismo patrón exacto que obras/ e inventario/: los lee cualquiera que haya
    // entrado —el operario necesita ver el nombre de su cuadrilla y su furgoneta—
    // y solo la oficina los mantiene.

    match /cuadrillas/{cuadrillaId} {
      allow get, list: if autenticado();
      allow create, update, delete: if esAdmin();
    }

    match /vehiculos/{vehiculoId} {
      allow get, list: if autenticado();
      allow create, update, delete: if esAdmin();
    }

    // ------------------------------------------------------ cuadrantes diarios
    //
    // El operario ve SU asignación y ninguna más. La pertenencia se resuelve contra la
    // CUADRILLA VIVA, no contra una copia congelada dentro de la asignación.
    //
    // POR QUÉ SE CAMBIÓ. Antes la asignación guardaba su propio `operarioEmails`, escrito
    // en el momento de crearla. Añadir a alguien a la cuadrilla después no le daba acceso
    // —había que rehacer la asignación— y quitarlo no se lo retiraba: seguía viendo el
    // trabajo hasta que alguien lo borraba a mano. Una copia de una lista que cambia deja
    // de ser verdad en cuanto la lista cambia.
    //
    // El `get()` por ruta es el mismo patrón que usa esAdmin() con roles/{uid}, y va
    // DESPUÉS de esAdmin() en el `||`: para la oficina el cortocircuito lo evita entero.
    //
    // Se lee de `operarioEmails` de la cuadrilla, un array PLANO de cadenas, y no de
    // `operarios`, que es un array de objetos: las reglas no saben proyectar un campo
    // dentro de un array de objetos.
    //
    // ⚠️ LA CONSULTA TIENE QUE FIJAR `cuadrillaId` CON == A UN ÚNICO VALOR.
    // Medido en el emulador, con UN solo documento y UNA sola cuadrilla:
    //     where('cuadrillaId','==', x)              -> pasa
    //     where('cuadrillaId','==', x) + fecha ==   -> pasa   (y con 60 documentos también)
    //     where('cuadrillaId','in', [x])            -> pasa
    //     where('cuadrillaId','in', [x, y])         -> FALLA
    //     where('fecha','==', hoy) sin cuadrillaId  -> FALLA
    //     la colección entera                       -> FALLA
    // No es un límite de volumen: la ruta del get() tiene que ser constante en toda la
    // consulta. Un operario en dos cuadrillas necesita DOS consultas, una por cuadrilla.
    // El índice que sostiene esto (cuadrillaId + fecha + horaInicio) ya estaba desplegado
    // desde la Pieza 2, así que este cambio no necesita índices nuevos.

    match /cuadrantes/{asignacionId} {

      function enLaCuadrillaViva() {
        return autenticado()
               && correo() != ''
               && exists(/databases/$(database)/documents/cuadrillas/$(resource.data.cuadrillaId))
               && correo() in get(/databases/$(database)/documents/cuadrillas/$(resource.data.cuadrillaId)).data.get('operarioEmails', []);
      }

      allow get, list: if esAdmin() || enLaCuadrillaViva();

      // Solo oficina planifica. El operario nunca escribe aquí: cuando envíe su
      // parte será la oficina, o una función, quien marque la asignación.
      //
      // Ya no se exige `operarioEmails`: la asignación no lo lleva. Sí `cuadrillaId`,
      // que es de lo que ahora cuelga el permiso de lectura — sin él la asignación no
      // sería legible para nadie salvo la oficina.
      allow create: if esAdmin()
                    && request.resource.data.cuadrillaId is string
                    && request.resource.data.cuadrillaId != ''
                    && request.resource.data.fecha is string
                    && request.resource.data.destinoTipo in ['obra', 'taller'];

      allow update: if esAdmin();
      allow delete: if esAdmin();
    }

    // ================================================ UNIDADES DE OBRA (Pieza 3)
    //
    // Avance certificable, AISLADO de los partes de RRHH. El operario PROPONE qué
    // unidad cerró al enviar su parte; la oficina CONFIRMA al validar (D7).
    //
    // Una propuesta no vale dinero: hasta que un admin la confirma no habilita nada.
    // Por eso el operario puede crearlas, pero no confirmarlas ni retocarlas después.

    match /unidades_obra/{unidadId} {

      function esSuyaLaPropuesta() {
        return autenticado()
               && resource.data.get('propuestaPor', '').lower() == correo();
      }

      // Todos leen: el operario necesita ver el avance de su obra, la oficina el mapa.
      allow get, list: if autenticado();

      // El operario propone. Solo en su nombre, solo como propuesta, y sin poder
      // rellenar los campos de confirmación.
      //
      // NO se comprueba aquí que el parte sea suyo: el parte se escribe sin esperar al
      // servidor (persistentLocalCache) y puede no existir todavía cuando llega la
      // unidad. La firma por correo ya impide proponer en nombre de otro, y una
      // propuesta sin confirmar no produce ningún efecto económico.
      allow create: if esAdmin() || (
           autenticado()
        && request.resource.data.estado == 'propuesta'
        && request.resource.data.propuestaPor.lower() == correo()
        && request.resource.data.confirmadaPor == null
        && request.resource.data.confirmadaEn == null
      );

      // SOLO LA OFICINA CONFIRMA. Es lo que separa "el operario dice que terminó" de
      // "la empresa da por terminada la unidad", que es lo único que puede facturarse.
      allow update: if esAdmin();

      // El operario retira su propia propuesta mientras nadie la haya confirmado:
      // equivocarse de habitación al teclear no debe requerir llamar a oficina.
      allow delete: if esAdmin() || (
           esSuyaLaPropuesta()
        && resource.data.get('estado', '') == 'propuesta'
      );
    }

    // ========================================================= ACOPIOS (Pieza 4)
    //
    // Material reservado para una obra. NO es inventario: `inventario/` y su descuento
    // al aprobar un parte siguen intactos (D4). Aquí no se resta stock de nada.
    //
    // A1: la oficina planifica qué hace falta y crea el acopio.
    // A3: el operario mueve TODOS los estados desde el móvil, no solo el último.

    match /acopios/{acopioId} {

      // Todos leen: el operario necesita saber qué cargar y qué falta.
      allow get, list: if autenticado();

      // Solo oficina planifica y retira. Un acopio es una decisión de qué comprar o
      // fabricar, no algo que surja en la obra.
      allow create, delete: if esAdmin();

      // El operario mueve el estado, y NADA MÁS. La lista blanca es lo que impide que
      // "marcar recepcionado" se convierta en "reescribir el acopio": no puede cambiar
      // de obra, ni de material, ni la cantidad, ni si requiere fabricación.
      //
      // EL ORDEN DE LOS ESTADOS NO SE COMPRUEBA AQUÍ, a propósito: vive en
      // src/logica/acopios.js, donde se prueba con node --test en milisegundos en vez
      // de levantando un emulador. Las reglas protegen de un tercero malicioso; la
      // lógica, del error honesto de un dedo con guantes.
      allow update: if esAdmin() || (
           autenticado()
        && tocados().hasOnly(['estado', 'historial', 'actualizadoEn', 'actualizadoPor'])
        && request.resource.data.actualizadoPor.lower() == correo()
        && request.resource.data.estado in ['pendiente', 'fabricado', 'recepcionado', 'listo']
      );
    }

    // ------------------------------------------------------- denegación por defecto

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
